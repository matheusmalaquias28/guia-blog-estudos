---
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import SectionHeader from '../components/SectionHeader.astro';
import type { IconItem, Img } from '../types';

interface Props {
  title: string;
  intro: string[];
  items: IconItem[];
  image: Img;
  id?: string;
}

const { title, intro, items, image, id } = Astro.props;
---

<section class="section section--soft" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <SectionHeader title={title} intro={intro} id={`${id}-title`} />

    <div class="deliv">
      <div class="deliv__media reveal">
        <ImageSlot
          src={image.src}
          alt={image.alt}
          hint={image.hint}
          ratio={image.src ? `${image.src.width} / ${image.src.height}` : '3 / 4'}
          fit="contain"
          sizes="(min-width: 1180px) 440px, (min-width: 900px) 38vw, 92vw"
          widths={[320, 480, 640, 800, 1080]}
          class={image.src ? 'deliv__img' : undefined}
        />
      </div>

      <ol class="deliv__list" role="list">
        {
          items.map((item) => (
            <li class="reveal">
              <span class="ico">
                <Icon name={item.icon} size={22} />
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .deliv {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .deliv__media {
    max-width: min(460px, 100%);
    width: 100%;
    margin-inline: auto;
  }

  .deliv__media :global(.slot) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Imagem real recortada (fundo transparente): sem moldura, sombra acompanhando o recorte. */
  .deliv__media :global(.deliv__img) {
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }

  .deliv__media :global(.deliv__img img) {
    filter: drop-shadow(0 20px 28px rgb(15 23 42 / 0.22));
  }

  .deliv__list {
    display: grid;
    gap: 14px;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    padding: 22px;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--c-success-soft);
    color: var(--c-success);
    box-shadow: inset 0 0 0 1px rgb(22 163 74 / 0.14);
  }

  h3 {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  p {
    font-size: var(--fs-sm);
    color: var(--c-muted);
    line-height: 1.65;
  }

  @media (min-width: 900px) {
    .deliv {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(40px, 5vw, 72px);
    }

    .deliv__media {
      position: sticky;
      top: 32px;
    }
  }
</style>
