---
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { rich } from '../lib/rich';
import type { Cta, Img } from '../types';

interface Props {
  /** Use *trecho* para destacar em cor. */
  title: string;
  subtitle: string;
  cta: Cta;
  note?: string;
  image: Img;
}

const { title, subtitle, cta, note, image } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__media">
      <ImageSlot
        src={image.src}
        alt={image.alt}
        hint={image.hint}
        ratio={image.src ? `${image.src.width} / ${image.src.height}` : '4 / 3'}
        tone="dark"
        fit="contain"
        priority
        sizes="(min-width: 1180px) 540px, (min-width: 960px) 44vw, 34vh"
        widths={[320, 480, 640, 800, 1080]}
        class={image.src ? 'hero__img' : undefined}
      />
    </div>

    <div class="hero__copy">
      <h1 id="hero-title" set:html={rich(title)} />
      <p class="hero__sub">{subtitle}</p>
      <div class="hero__actions">
        <CtaButton href={cta.href} block>{cta.label}</CtaButton>
        {
          note && (
            <p class="hero__note">
              <Icon name="mail" size={16} />
              <span>{note}</span>
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-ink);
    color: var(--c-on-dark);
    padding-block: 14px 28px;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 45% at 50% 0%, rgb(var(--c-cta-ring) / 0.16), transparent 70%),
      radial-gradient(45% 40% at 100% 35%, rgb(250 204 21 / 0.07), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 100% 40px;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .hero__grid {
    display: grid;
    gap: clamp(14px, 2.2svh, 24px);
  }

  /* Mobile: a imagem tem altura limitada pela viewport para que tudo caiba na 1ª dobra. */
  .hero__media {
    height: clamp(140px, 32svh, 340px);
    display: flex;
    justify-content: center;
  }

  .hero__media :global(.slot) {
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  /* Imagem real (PNG recortado): sem cantos arredondados, com brilho sutil atrás. */
  .hero__media {
    position: relative;
  }

  .hero__media::before {
    content: '';
    position: absolute;
    inset: 12% 8%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(220 38 38 / 0.28), rgb(var(--c-cta-ring) / 0.08) 60%, transparent);
    filter: blur(24px);
  }

  .hero__media :global(.hero__img) {
    border-radius: 0;
    overflow: visible;
  }

  .hero__media :global(.hero__img img) {
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45));
  }

  .hero__copy {
    display: grid;
    gap: clamp(10px, 1.8svh, 18px);
    text-align: center;
  }

  h1 :global(mark) {
    white-space: nowrap;
  }

  h1 {
    font-size: var(--fs-h1);
    line-height: 1.14;
    letter-spacing: -0.015em;
    font-weight: 800;
  }

  .hero__sub {
    font-size: clamp(0.875rem, 0.8rem + 0.45vw, 1.1875rem);
    line-height: 1.55;
    color: var(--c-on-dark-2);
    max-width: 62ch;
    margin-inline: auto;
  }

  .hero__actions {
    display: grid;
    gap: 10px;
    margin-top: 4px;
    justify-items: center;
  }

  .hero__note {
    font-size: var(--fs-xs);
    color: var(--c-on-dark-2);
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  .hero__note :global(svg) {
    display: inline-block;
    vertical-align: -3px;
    margin-right: 6px;
    color: var(--c-cta-hi);
  }

  @media (max-height: 700px) and (max-width: 959px) {
    .hero {
      padding-block: 10px 20px;
    }
    .hero__media {
      height: clamp(110px, 22svh, 200px);
    }
    .hero__sub {
      font-size: 0.84rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 600px) and (max-width: 959px) {
    .hero__actions :global(.cta) {
      width: auto;
    }
  }

  /* Desktop: duas colunas, texto à esquerda, imagem à direita. */
  @media (min-width: 960px) {
    .hero {
      padding-block: clamp(40px, 6svh, 72px);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
    }

    .hero__media {
      order: 2;
      height: auto;
    }

    .hero__media :global(.slot) {
      width: 100%;
      height: auto;
    }

    .hero__copy {
      text-align: left;
      gap: 22px;
    }

    .hero__sub {
      margin-inline: 0;
    }

    .hero__actions {
      justify-items: start;
    }

    .hero__note {
      text-align: left;
    }

    .hero__actions :global(.cta) {
      width: auto;
    }
  }
</style>
