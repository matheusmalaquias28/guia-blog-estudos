---
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { rich } from '../lib/rich';
import type { Plan } from '../types';

interface Props {
  title: string;
  intro?: string[];
  /** Quadro de destaque abaixo do título (aceita **negrito** e __verde__). */
  callout?: string[];
  plans: Plan[];
  footnote?: string;
  id?: string;
}

const { title, intro = [], callout = [], plans, footnote, id } = Astro.props;

const toNumber = (v: string) => Number(v.replace(/\./g, '').replace(',', '.'));
const brl = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const savings = (p: Plan) => (p.oldPrice ? brl(toNumber(p.oldPrice) - toNumber(p.price)) : null);
---

<section class="section section--soft" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <SectionHeader title={title} intro={intro} id={`${id}-title`} class={callout.length ? 'sh--tight' : undefined} />

    {
      callout.length > 0 && (
        <div class="callout reveal">
          {callout.map((p) => (
            <p set:html={rich(p)} />
          ))}
        </div>
      )
    }

    <div class="plans">
      {
        plans.map((plan) => (
          <article class:list={['plan', 'reveal', { 'plan--featured': plan.featured }]}>
            <header class="plan__head">
              <span class="plan__tag">{plan.tag}</span>
              <h3>{plan.name}</h3>
            </header>

            {plan.image && (
              <div class="plan__media">
                <ImageSlot
                  src={plan.image.src}
                  alt={plan.image.alt}
                  hint={plan.image.hint}
                  ratio={plan.image.src ? `${plan.image.src.width} / ${plan.image.src.height}` : '1 / 1'}
                  fit="contain"
                  sizes="(min-width: 820px) 300px, 70vw"
                  widths={[320, 480, 640, 800, 1080]}
                  class="plan__img"
                />
              </div>
            )}

            <ul class="plan__list" role="list">
              {plan.features.map((f) => (
                <li>
                  <span class="tick">
                    <Icon name="check" size={14} stroke={3.2} />
                  </span>
                  <span>{f}</span>
                </li>
              ))}
              {plan.excluded?.map((f) => (
                <li class="off">
                  <span class="tick tick--off">
                    <Icon name="x" size={13} stroke={3.2} />
                  </span>
                  <del>{f}</del>
                </li>
              ))}
            </ul>

            <div class="plan__foot">
              <div class="pricebox">
                {plan.oldPrice && (
                  <p class="price__old">
                    de <s>{plan.currency ?? 'R$'} {plan.oldPrice}</s> por:
                  </p>
                )}
                <p class="price">
                  <span class="price__cur">{plan.currency ?? 'R$'}</span>
                  <span class="price__val">{plan.price}</span>
                </p>
                {plan.installments && <p class="price__inst">ou {plan.installments} no cartão</p>}
                {savings(plan) && (
                  <p class="price__save">
                    <Icon name="check" size={18} stroke={3} />
                    Você economiza {plan.currency ?? 'R$'} {savings(plan)}
                  </p>
                )}
              </div>
              <CtaButton href={plan.cta.href} block checkout size="md">
                {plan.cta.label}
              </CtaButton>
              {plan.notice && (
                <div class="notice">
                  <p>
                    <Icon name="alert" size={17} stroke={2.4} class="notice__ic" />
                    <strong>{plan.notice.label}</strong>{' '}
                    <span set:html={rich(plan.notice.text)} />{' '}
                    <span class="notice__below">{plan.notice.below}</span>
                    <span class="notice__beside">{plan.notice.beside}</span>
                  </p>
                  <span class="notice__arrows" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 6 6 6-6"/><path d="m6 13 6 6 6-6"/></svg>
                  </span>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      footnote && (
        <p class="foot reveal">
          <Icon name="shieldCheck" size={20} />
          <span>{footnote}</span>
        </p>
      )
    }
  </div>
</section>

<style>
  :global(.sh--tight) {
    margin-bottom: 24px !important;
  }

  .callout {
    display: grid;
    gap: 10px;
    max-width: 580px;
    margin: 0 auto clamp(32px, 4vw, 48px);
    padding: 22px clamp(18px, 4vw, 30px);
    text-align: center;
    background: #fdeee4;
    border: 2px dashed #f4a37a;
    border-radius: 18px;
    color: var(--c-text-2);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .callout :global(strong) {
    color: var(--c-text);
    font-weight: 800;
  }

  /* Valores (R$ ...) nunca quebram no meio. */
  .callout p:first-child :global(strong) {
    white-space: nowrap;
  }

  .callout :global(.u) {
    color: #146c34;
  }

  .plans {
    display: grid;
    gap: 20px;
    max-width: 920px;
    margin-inline: auto;
  }

  @media (min-width: 820px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(24px, 3vw, 34px);
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .plan--featured {
    border-color: transparent;
    box-shadow:
      0 0 0 2px var(--c-cta),
      0 28px 56px -20px rgb(var(--c-cta-ring) / 0.35),
      var(--shadow-md);
  }

  .plan--featured::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(80% 40% at 50% 0%, rgb(var(--c-cta-ring) / 0.09), transparent 70%);
    pointer-events: none;
  }

  .plan__head {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
    padding-bottom: 20px;
    border-bottom: 1px dashed var(--c-line-strong);
  }

  .plan__tag {
    justify-self: center;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--c-bg-soft);
    color: var(--c-text-2);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  .plan--featured .plan__tag {
    background: var(--c-cta);
    color: #fff;
    box-shadow: none;
  }

  h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
  }

  .plan__media {
    width: min(300px, 80%);
    margin-inline: auto;
  }

  .plan__media :global(.plan__img) {
    border-radius: 0;
    overflow: visible;
  }

  .plan__media :global(img) {
    filter: drop-shadow(0 16px 22px rgb(15 23 42 / 0.22));
  }

  .plan__list {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .plan__list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.55;
  }

  .tick {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--c-success-soft);
    color: var(--c-success);
  }

  /* Itens não inclusos: X vermelho forte, texto riscado e esmaecido. */
  .plan__list del {
    color: #6b7280;
    text-decoration-thickness: 1.5px;
    text-decoration-color: currentColor;
  }

  .tick--off {
    background: #fee2e2;
    color: var(--c-danger);
  }

  .plan__foot {
    margin-top: auto;
    display: grid;
    gap: 16px;
  }

  .pricebox {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }

  .price__old {
    font-size: var(--fs-base);
    font-weight: 500;
    color: #6b7280;
  }

  .price__old s {
    text-decoration-thickness: 1.5px;
  }

  .price__inst {
    font-size: var(--fs-base);
    font-weight: 800;
    color: var(--c-text);
  }

  .price__save {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--c-cta-lo);
  }

  /* Aviso abaixo do botão */
  .notice {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .notice p {
    padding: 12px 16px;
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: #7f1d1d;
    background: #fef2f2;
    border: 2px solid #ef4444;
    border-radius: 14px;
  }

  .notice strong {
    color: #c81e1e;
    font-weight: 800;
  }

  .notice :global(.notice__ic) {
    display: inline-block;
    vertical-align: -3px;
    margin-right: 4px;
    color: var(--c-danger);
  }

  .notice :global(.u) {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .notice__beside {
    display: none;
  }

  .notice__arrows {
    color: var(--c-danger);
    animation: notice-bounce 1.6s var(--ease-out) infinite;
  }

  @keyframes notice-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* Desktop: o plano completo fica ao lado, então o aviso aponta para a direita. */
  @media (min-width: 820px) {
    .notice__below {
      display: none;
    }

    .notice__beside {
      display: inline;
    }

    .notice__arrows svg {
      transform: rotate(-90deg);
    }

    @keyframes notice-bounce {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(5px);
      }
    }
  }

  .price {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
    color: var(--c-cta-lo);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price__cur {
    font-size: 1.25rem;
    margin-top: 0.45em;
  }

  .price__val {
    font-size: clamp(2.75rem, 2.2rem + 2vw, 3.5rem);
    font-variant-numeric: tabular-nums;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    color: var(--c-text-2);
    font-weight: 700;
    font-size: var(--fs-sm);
  }

  .foot :global(svg) {
    color: var(--c-success);
  }
</style>
