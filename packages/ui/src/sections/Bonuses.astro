---
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import SectionHeader from '../components/SectionHeader.astro';
import type { Bonus } from '../types';

interface Props {
  title: string;
  items: Bonus[];
  id?: string;
}

const { title, items, id } = Astro.props;
---

<section class="section section--dark bonus" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <SectionHeader title={title} id={`${id}-title`}>
      <span slot="before" class="bonus__gift"><Icon name="gift" size={26} /></span>
    </SectionHeader>

    <ul class="grid" role="list">
      {
        items.map((b) => (
          <li class="card reveal">
            <div class:list={['card__media', { 'card__media--img': b.image.src }]}>
              <ImageSlot
                src={b.image.src}
                alt={b.image.alt}
                hint={b.image.hint}
                ratio={b.image.src ? '1 / 1' : '4 / 3'}
                tone="dark"
                fit="contain"
                sizes="(min-width: 860px) 240px, 62vw"
                widths={[240, 360, 480, 720]}
              />
            </div>
            <div class="card__body">
              <span class="tag">{b.tag}</span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bonus {
    overflow: hidden;
    isolation: isolate;
  }

  .bonus::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 40% at 50% 0%, rgb(250 204 21 / 0.12), transparent 70%);
  }

  .bonus__gift {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    color: var(--c-accent);
    background: rgb(250 204 21 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(250 204 21 / 0.3);
  }

  .grid {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 860px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 10px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--c-ink-3), var(--c-ink-2));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 24px 48px -24px rgb(0 0 0 / 0.6);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
      box-shadow:
        inset 0 0 0 1px rgb(250 204 21 / 0.3),
        0 28px 56px -24px rgb(0 0 0 / 0.7);
    }
  }

  .card :global(.slot) {
    border-radius: 14px;
  }

  /* Capa real (livro recortado): palco com brilho e sombra acompanhando o recorte. */
  .card__media--img {
    padding: 22px 18px 10px;
    border-radius: 14px;
    background:
      radial-gradient(60% 55% at 50% 45%, rgb(250 204 21 / 0.14), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .card__media--img :global(.slot) {
    border-radius: 0;
    overflow: visible;
  }

  .card__media--img :global(img) {
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.55));
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover .card__media--img :global(img) {
      transform: translateY(-4px) rotate(-1deg);
    }
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 18px 14px 16px;
  }

  .tag {
    justify-self: start;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--c-on-dark);
  }

  p {
    font-size: var(--fs-sm);
    color: var(--c-on-dark-2);
    line-height: 1.65;
  }
</style>
